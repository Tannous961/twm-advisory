# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cadre editorial drafts / research traces (published posts live in content/cadre/)
content/cadre-drafts/**
!content/cadre-drafts/.gitkeep
content/cadre-sources/**
!content/cadre-sources/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
