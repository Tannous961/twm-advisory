NEXT_PUBLIC_SITE_URL=https://www.twm.expert
NEXT_PUBLIC_CONTACT_EMAIL=tannous@twm.expert
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_FOUNDER_NAME=Tannous Mekari

# Google Tag Manager (container). GA4 is fired from GTM tags — do not also set
# NEXT_PUBLIC_GA_MEASUREMENT_ID unless you intentionally want a second direct hit.
NEXT_PUBLIC_GTM_ID=GTM-KQC5BDFC
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase (intake game — server uses service role only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (required in production for intake and partner forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.twm.expert,twm.expert

# Request/session protection — generate distinct random values (32+ bytes)
INTAKE_SESSION_SECRET=
RATE_LIMIT_SALT=

# AI brief — prefer OpenRouter (chat + Whisper). OpenAI still works as fallback.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_STT_MODEL=openai/whisper-1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Email notify (Resend). Domain twm.expert must be verified in Resend.
RESEND_API_KEY=
INTAKE_NOTIFY_EMAIL=tannous@twm.expert
INTAKE_FROM_EMAIL=TWM Advisory <notifications@twm.expert>

# Optional JSON webhook for processing/email failures (no lead PII is sent)
OPS_ALERT_WEBHOOK_URL=
